{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "store",
      "credentialsSource": "remote",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_CLERK_PROXY_URL": "https://www.chargebridgeapp.com/api/__clerk"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_CLERK_PROXY_URL": "https://www.chargebridgeapp.com/api/__clerk"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "latest",
        "resourceClass": "medium"
      }
    },
    "evidence": {
      "channel": "evidence",
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_CLERK_PROXY_URL": "https://www.chargebridgeapp.com/api/__clerk"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium",
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "ianblackett.a@gmail.com",
        "ascAppId": "6768124853",
        "appleTeamId": "QZB8W64B65"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
