{
  "name": "@workspace/chargebridge-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-expo-cli.cjs",
    "eas-build-post-install": "node scripts/patch-expo-cli.cjs && node scripts/run-nav-timing-gate.cjs",
    "dev": "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "eas:build:ios": "EAS_NO_VCS=1 EAS_BUILD_NO_EXPO_GO_WARNING=true eas build --platform ios --profile production --non-interactive --no-wait",
    "eas:build:android": "EAS_NO_VCS=1 EAS_BUILD_NO_EXPO_GO_WARNING=true eas build --platform android --profile production --non-interactive --no-wait",
    "serve": "node server/serve.js",
    "test": "jest && node scripts/__tests__/check-nav-timing-summary.test.cjs",
    "test:scripts": "node scripts/__tests__/check-nav-timing-summary.test.cjs && node scripts/__tests__/run-nav-timing-gate.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "configFile": "./babel.config.js"
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^expo/virtual/env$": "<rootDir>/__mocks__/expo-virtual-env.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(expo-secure-store|expo-speech|expo-speech-recognition|expo-modules-core)/)"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "@stripe/stripe-react-native",
        "react-native-maps",
        "react-native-carplay",
        "expo-speech-recognition",
        "expo-audio"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-carplay",
          "@solana-mobile/mobile-wallet-adapter-protocol"
        ]
      }
    }
  },
  "devDependencies": {
    "yaml": "^2.9.0",
    "@babel/core": "^7.29.0",
    "@clerk/expo": "^3.7.8",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/cli": "^57.0.9",
    "@expo/config-plugins": "~57.0.0",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.8",
    "@types/react-dom": "~19.1.5",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "@workspace/design-tokens": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~57.0.3",
    "expo": "~57.0.7",
    "expo-auth-session": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.5",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.2",
    "zod": "3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": "1.1.11",
      "minimatch@5>brace-expansion": "5.0.6"
    }
  },
  "dependencies": {
    "@sentry/react-native": "^8.19.0",
    "@stripe/stripe-react-native": "^0.66.0",
    "expo": "~57.0.7",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-brightness": "~57.0.1",
    "expo-calendar": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.6",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "~56.0.1",
    "expo-task-manager": "~57.0.5",
    "expo-updates": "~57.0.11",
    "posthog-react-native": "^4.57.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-carplay": "2.4.1-beta.0",
    "react-native-maps": "1.27.2"
  }
}
