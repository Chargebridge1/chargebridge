{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "postinstall": "simple-git-hooks || true",
    "eas-build-post-install": "node artifacts/chargebridge-mobile/scripts/patch-expo-cli.cjs && node artifacts/chargebridge-mobile/scripts/check-analytics-env.cjs",
    "check-singletons": "pnpm --filter @workspace/scripts run check-singletons",
    "build": "pnpm run check-singletons && pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run check-singletons",
    "pre-push": "node artifacts/chargebridge-mobile/scripts/run-nav-timing-gate.cjs"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.11.1",
    "typescript": "~5.9.2"
  },
